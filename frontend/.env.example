# ==========================================
# MST Multi-Sig Terminal Frontend Env Config
# ==========================================

# 1. Smart Contract Address deployed on MST Testnet (already bundled, but can be overridden)
VITE_CONTRACT_ADDRESS=0x7b86F2a24306b246e823d698815DCE356A9CBadF

# 2. MST Blockchain Network Details
VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_CHAIN_ID=91562037
VITE_MST_EXPLORER_URL=https://testnet.mstscan.com

# 3. IoT Relay Server URL (Optional)
# If your Relay server is deployed (e.g. Render, Railway, or Ngrok), set its URL:
# Example: https://mst-terminal-relay.up.railway.app
# If left empty, it will default to http://localhost:5001 for local testing.
VITE_RELAY_API_URL=
